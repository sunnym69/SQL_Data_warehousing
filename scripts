-- =============================================================
-- BRONZE LAYER: Load CSV files into Delta tables
-- =============================================================


-- 1. CRM Customer Information
CREATE OR REPLACE TABLE datawarehouse.bronze.crm_cust_info
USING DELTA
AS
SELECT *
FROM read_files(
    '/Volumes/datawarehouse/bronze/raw_data/cust_info.csv',
    format => 'csv',
    header => true
);


